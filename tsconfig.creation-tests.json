{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "jsx": "react-jsx",
    "noEmit": false,
    "incremental": false,
    "outDir": ".test-build",
    "rootDir": ".",
    "plugins": []
  },
  "include": [
    "app/components/position-picker.tsx",
    "app/components/player-setup.tsx",
    "app/components/career-event.tsx",
    "app/components/draft-board.tsx",
    "app/components/training-editor.tsx",
    "app/components/career-continuation.tsx",
    "app/components/season-records.tsx",
    "app/components/player-abilities.tsx",
    "app/components/draft-round-badge.tsx",
    "app/components/draft-result-gate.tsx",
    "lib/career-save.ts",
    "app/components/pro-career-panels.tsx"
  ],
  "exclude": [
    "node_modules",
    ".next",
    ".test-build"
  ]
}
